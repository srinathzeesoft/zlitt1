<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text css-class="body-text" font-family='Helvetica Neue, Helvetica' />
      <mj-button font-family="Helvetica Neue, Helvetica" />
      <mj-class name='bg-color-checkr-blue' background-color='#043f93' />
      <mj-class name='bg-color-grey' background-color='#f3f3f3' />
    </mj-attributes>
    <mj-style inline="inline">
      .checkr-link {
        color: #043f93;
        text-decoration: 'none';
      }
      .logo-img {
        max-height: 24px;
        max-width: 185px;
        padding: 0px 20px;
      }
      .body-padding-upper {
        padding-left: 16px;
        padding-right: 16px;
      }
      .body-padding-lower {
        padding-left: 0px;
        padding-right: 0px;
      }
      .body-padding-upper td {
        padding-top: 10px !important;
      }
      .cta-img-padding td {
        padding-top: 0px !important;
      }
      .cta-button-padding td {
        padding-top: 10px;
        padding-bottom: 20px !important;
      }
      .cta-button-padding td td {
        padding-bottom: 10px !important;
      }
      .body-text div, .body-text a {
        font-size: 12px;
      }
      .subject-text div {
        font-size: 14px;
        padding-top: 10px;
      }
    </mj-style>
    <mj-style>
      @media screen and (min-width: 415px) {
        .logo-img {
          max-height: 35px !important;
          padding: 20px 20px !important;
        }
        .body-padding-upper {
          padding-left: 32px !important;
          padding-right: 32px !important;
        }
        .body-padding-upper td {
          padding-top: 10px !important;
        }
        .cta-img-padding td {
          padding-top: 5px !important;
        }
        .cta-button-padding td {
          padding-top: 10px !important;
          padding-bottom: 40px !important;
        }
        .cta-button-padding td td {
          padding-bottom: 10px !important;
        }
        .body-padding-lower {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
        .body-text div, .body-text a {
          font-size: 14px !important;
        }
        .subject-text div {
          font-size: 18px !important;
          padding-top: 30px !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body>
    <mj-container>
      <mj-section mj-class="bg-color-checkr-blue" full-width="full-width" padding-top="70px" padding-bottom="0px" padding-left="16px" padding-right="16px">
        <mj-section background-color="#fff" border-radius="10px 10px 0px 0px" padding-top="10px" border="none" padding-bottom="0px">
          <mj-column background-color="#fff" border="none" full-width="full-width">
            <mj-text align="center" padding-bottom="0">
              <img src="{{logo_uri}}" class="logo-img logo-border" />
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-section>
      %%BODY%%
      {{#if is_not_default_locale }}
        %%DEFAULT_BODY%%
      {{/if}}
      <mj-section mj-class="bg-color-grey" full-width="full-width">
        <mj-column>
          <mj-image width="120px" src="https://us-east-1-checkr.s3.amazonaws.com/assets/communicator/checkr-logo-2022.png"></mj-image>
          <mj-text align="center"></mj-text>
          <mj-text align="center" color="#999">
            1 Montgomery St, Ste 2400, San Francisco, CA 94104
          </mj-text>
          <mj-text align="center">
            <a href="{{unsubscribe_link}}" style="color: #999">Abmelden</a>&nbsp;&nbsp;
            <a href="https://help.checkr.com/hc/en-us/categories/360002478633-Candidates" style="color: #999">FAQs</a>&nbsp;&nbsp;
            <a href="https://checkr.com/privacy-policy" style="color: #999">Datenschutzrichtlinie</a>
          </mj-text>
          <mj-text align="center" color="#999">
            Sie erhalten diese E-Mail, da Sie sich bei {{segment_name}} um eine Arbeitsstelle beworben haben. Checkr wurde mit der Durchführung Ihrer Hintergrundüberprüfung beauftragt.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-container>
  </mj-body>
</mjml>
